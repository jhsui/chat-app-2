# Copy this file to .env and change the values.

# Secret used to sign login tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Port for the API / WebSocket server (the Vite dev server proxies to it)
PORT=3001

# PostgreSQL connection string. Leave unset to use the embedded PGlite
# database in server/data/pglite (no install needed). On Railway, reference the
# Postgres service's variable: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgres://user:password@localhost:5432/chat

# Where the embedded PGlite database is stored when DATABASE_URL isn't set
# PGLITE_DIR=./data/pglite

# Only needed if you host the React app on a different domain than the API
# CLIENT_ORIGIN=https://your-frontend.example.com
